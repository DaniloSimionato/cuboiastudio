NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Backend auth / session signing
JWT_SECRET=
AUTH_TRUST_MODE=off
AUTH_PROXY_SHARED_SECRET=
AUTH_PROXY_SIGNATURE_TTL_MS=300000

# Tenant/app secret encryption (32 bytes em hex/base64)
APP_ENCRYPTION_KEY=

# Database / cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cubo_ai_studio?schema=public
REDIS_URL=redis://localhost:6379

# AI provider defaults / fallback
AI_RUNTIME_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=30000
# Optional per-assistant RAG thresholds, e.g. assistant-id:0.55
ASSISTANT_KNOWLEDGE_MIN_SCORE_OVERRIDES=
# Opt-in tag-based knowledge scopes for specific assistants, e.g. assistant-id
KNOWLEDGE_SCOPE_TAG_FILTER_ASSISTANT_IDS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Chatwoot / CuboChat
CHATWOOT_URL=http://localhost:3000
CHATWOOT_TOKEN=
CHATWOOT_ALLOW_INSECURE_WEBHOOKS=false
CHATWOOT_ATTACHMENT_DOWNLOAD_TIMEOUT_MS=15000
CHATWOOT_ATTACHMENT_MAX_IMAGE_BYTES=10485760
CHATWOOT_ATTACHMENT_MAX_AUDIO_BYTES=20971520
CHATWOOT_ATTACHMENT_MAX_VIDEO_BYTES=20971520
CHATWOOT_ATTACHMENT_MAX_DOCUMENT_BYTES=15728640
# Operational handoff recovery is local/test-only in this phase.
# The runner also fails closed in staging and production.
HANDOFF_RECOVERY_ENABLED=false
HANDOFF_RECOVERY_INTERVAL_MS=60000
HANDOFF_RECOVERY_BATCH_LIMIT=25
HANDOFF_RECOVERY_LEASE_MS=60000
HANDOFF_RECOVERY_MAX_MUTATION_ATTEMPTS=3
HANDOFF_RECOVERY_BACKOFF_BASE_MS=60000
HANDOFF_RECOVERY_BACKOFF_CAP_MS=3600000
HANDOFF_RECOVERY_JITTER_RATIO=0.1

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Frontend
VITE_API_URL=http://localhost:3001
VITE_PUBLIC_API_URL=
VITE_APP_PUBLIC_API_URL=
VITE_API_PUBLIC_URL=
